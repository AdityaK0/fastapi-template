DATABASE_URL=postgresql://postgres:password@localhost:5432/tracker_db
APP_ENV=development
JWT_SECRET_KEY=your-secret-key-here-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# AI assistant (optional). AI features stay off until AI_API_KEY is set.
# Never commit a real key; it is only read by the backend.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_MAX_OUTPUT_TOKENS=16000
# AI_EFFORT=medium
# AI_TEMPERATURE=0.7   # only for models that accept sampling params; Opus 4.7+ rejects it
AI_REFUSAL_FALLBACK=true
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_TOOL_ROUNDS=6
AI_CONTEXT_MAX_MESSAGES=20
AI_MAX_MESSAGE_CHARS=2000
AI_MAX_TURNS_PER_CONVERSATION=60
AI_RATE_LIMIT_PER_MINUTE=8
AI_RATE_LIMIT_PER_DAY=200
