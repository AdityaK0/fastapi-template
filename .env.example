DATABASE_URL=postgresql://postgres:password@localhost:5432/tracker_db
APP_ENV=development
JWT_SECRET_KEY=your-secret-key-here-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# AI assistant (optional). AI features stay off until at least one provider has a key.
# Never commit real keys; they are only read by the backend.
#
# AI_PROVIDERS declares one or more providers in PRIORITY order (first = primary,
# the rest are automatic fallbacks). Entries are separated by newlines, commas or
# semicolons; each entry is:
#     id | model | api_key | base_url
# where the last two are optional:
#   - id:       anthropic, gemini, openai, openrouter, groq, mistral, qwen,
#               grok, nvidia, deepseek, or any custom id + base_url
#   - model:    the model id; empty = the provider default
#   - api_key:  the key, or env:NAME to read another env var; empty = use the
#               provider's conventional env var (e.g. OPENROUTER_API_KEY)
#   - base_url: override the built-in base URL (required for custom ids)
#
# Example: OpenRouter first, Gemini as fallback.
# AI_PROVIDERS=openrouter|openai/gpt-4o-mini|env:OPENROUTER_API_KEY
#              gemini|gemini-3.5-flash|env:GEMINI_API_KEY
AI_PROVIDERS=
# Keys referenced with env:NAME above (or used by the legacy single-provider setup).
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Legacy single-provider setup, used only when AI_PROVIDERS is empty.
# AI_PROVIDER: "anthropic" (Claude), "gemini" (Google) or "disabled".
AI_PROVIDER=disabled
AI_API_KEY=
# Leave AI_MODEL blank to use the provider default (claude-opus-5 / gemini-3.5-flash).
AI_MODEL=
AI_FALLBACK_ON_ERROR=true
AI_MAX_OUTPUT_TOKENS=16000
# AI_EFFORT=medium
# AI_TEMPERATURE=0.7   # only for models that accept sampling params; Opus 4.7+ rejects it
AI_REFUSAL_FALLBACK=true
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_TOOL_ROUNDS=6
AI_CONTEXT_MAX_MESSAGES=20
AI_MAX_MESSAGE_CHARS=2000
AI_MAX_TURNS_PER_CONVERSATION=60
AI_RATE_LIMIT_PER_MINUTE=8
AI_RATE_LIMIT_PER_DAY=200
